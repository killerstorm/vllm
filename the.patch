+        sys.exit(1)
+    
+    print(f"\nBatch verification completed successfully!")
+    print(f"Total verified: {summary.get('verified', 0)}/{summary.get('total', 0)}")
+    
+    print("\n--- All tests finished successfully! ---")
+
+
+if __name__ == "__main__":
+    main()
